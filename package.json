{
  "name": "discord-search",
  "version": "0.1.0",
  "description": "Search Discord server messages from your terminal. Filter by author, content type, mentions, and more.",
  "keywords": [
    "bun",
    "cli",
    "discord",
    "discord-api",
    "search",
    "terminal"
  ],
  "homepage": "https://github.com/mynameistito/discord-search#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/discord-search/issues"
  },
  "license": "MIT",
  "author": {
    "name": "mynameistito",
    "email": "github@mynameistito.com",
    "url": "https://mynameistito.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/discord-search.git"
  },
  "bin": {
    "discord-search": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "bun src/index.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest run",
    "prepare": "lefthook install",
    "typecheck": "tsgo --noEmit",
    "prepublishOnly": "bun run typecheck && bun run check && bun run build",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "better-result": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsdown": "^0.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "8.0.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.4.3"
}
